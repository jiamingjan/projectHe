<script src="~/lib/vue-vxe/js/vxe/vxe-table-plugin-export-xlsx4.0.7.js"></script>
<script src="~/lib/vue-vxe/js/vxe/vxe-table-plugin-export-pdf4.0.4.js"></script>
<script src="~/lib/vue-vxe/js/axios/axios.min.js"></script>
<script src="~/lib/vue-vxe/js/xe/xe-ajax.umd.min4.0.5.js"></script>
<script src="~/lib/old/js/MyTool.js"></script>
<script src="~/lib/old/js/js.cookie.min.js"></script>

<script type="text/javascript">
    //下面访问后台可以选择axios或者xe-ajax，都可以，
    // 创建axios实例时配置默认值
    const AXios = axios.create({
        baseURL: ''
    });
    // 创建实例后修改默认值，axios带上拦截器请求头
        AXios.defaults.headers.common['Authorization'] = `Bearer ${Cookies.get('token')}`;

    //XEAjax
    XEAjax.setup({
    // 除非 url 是绝对路径（'/api/list' 或 '//test.com/api/list' 或 'https://test.com/api/list'），
    // 否则 baseURL 会拼接在 url 之前
    baseURL: '',
    bodyType: 'json-data',
    credentials: 'include',
    headers: {
    'Accept': 'application/json, text/plain, \*/\*;',
    'Authorization':`Bearer ${Cookies.get('token')}`,
    }    
})


</script>

@RenderSection("JS", false)
