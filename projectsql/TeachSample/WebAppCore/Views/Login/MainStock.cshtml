
@{
    ViewBag.Title = "管理平台";
    Layout = "~/Views/Shared/_Layout_Old.cshtml";
}
@section CSS{
    <link href="~/lib/old/css/style.css" rel="stylesheet" />
    <link href="~/lib/old/css/animate.css" rel="stylesheet" />
    <link href="~/lib/old/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/lib/old/js/plugins/layer/skin/layer.css" rel="stylesheet" />
    <link href="~/lib/old/js/plugins/layui/css/layui.css" rel="stylesheet" />
    <style>
        /*这里仅仅改变.layui-layer-tab下的css（因为需要向左靠齐，否则会留出很多空来），否则所有layer下面都修改了，
            会导致layer.msg, layer.confirm都错乱*/
        .layui-layer-tab .layui-layer-content {
            position: absolute !important;
            left: 0px !important;
        }

        .layui-layer-tab .layui-layer-tabmain {
            padding: 0px;
        }

        .form-group {
            margin-right: 30px;
            margin-bottom: 15px;
        }

            .form-group label {
                margin-right: 10px;
            }
    </style>
}
@section JS{
    <!-- 我的js-->

    <script src="~/lib/old/js/plugins/jqgrid/jquery.jqGrid.min.js?0820"></script>
    <script src="~/lib/old/js/layer.min.js"></script>
 
    <!-- 自定义js -->
    <script src="~/lib/old/js/hplus.js?v=4.1.0"></script>
    <script src="~/lib/old/js/contabs.js"></script>    
    <!-- 第三方插件 -->
    <script src="~/lib/old/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="~/lib/old/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/lib/old/js/plugins/pace/pace.min.js"></script>
    <script src="~/js/Main.js"></script>
    <script src="~/lib/old/js/plugins/layui/lay/modules/jquery.js"></script>
    <script src="~/lib/old/js/plugins/layui/layui.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/js-cookie@2/src/js.cookie.min.js'></script>
    <script>

    </script>
}
