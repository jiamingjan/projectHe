    <script src="~/lib/login-new/js/jquery.sticky.js"></script>
    <script src="~/lib/login-new/js/jquery.easing.min.js"></script>


    <!--Custom JS-->
    <script src="~/lib/login-new/js/custom.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/old/js/layer.min.js"></script>
    <script src="~/lib/old/js/md5.js"></script>
    <script src="~/lib/old/js/js.cookie.min.js"></script>
    
    <script>
        function GetCaptchaShow()
        {
            $.ajax({
                url: '/User/getCaptcha', // 假设你的后端API在这里
                method: 'GET',
                success: function(response) {
                    var json = $.parseJSON(response);
                    //
                    if (response && json && json.base64Captcha) {
                            $('#captchaImage').attr('src', json.base64Captcha); // 更新图片源
                    } else {
                        alert('获取验证码失败');
                    }
                },
                error: function() {
                    alert('请求验证码时发生错误');
                }
            });
        }

        $(document).ready(function() 
        {
            GetCaptchaShow();

            $('#captchaImage').click(function(){
            // 发送请求到后端API获取验证码图片的URL
                GetCaptchaShow();
            });

            $('#btnLogin').click(function() {        
                var UserName = $("#UserName").val();
                var Password = $("#Password").val();
                var Captcha = $("#captchaInput").val();
                Password = hex_md5(Password);
                if (UserName == "" || Password == "") 
                {
                    layer.alert("请输入账号密码！");                
                    return;
                }

                $.ajax({
                    url: "../User/login", //用../User/login真实登录，../Login/login是假登录
                    type: "POST",
                    contentType: "application/json; charset=utf-8",
                    async: false,
                    data: JSON.stringify({username: UserName,password:Password,captcha:Captcha}),
                    success: function (data) {
                        var json = $.parseJSON(data);
                        if (json.code == 200) {
                            //角色设置，临时注释
                            Cookies.set('token', json.data.token, { expires: json.data.expire, path: '/' }); //秒钟
                            //或者:
                            //localStorage.setItem('token', json.data.token);
                            //Cookies.set('RoleId', json.data, { expires: 6000, path: '/' });
                            //Cookies.set('UserName', UserName, { expires: 6000, path: '/' });

                            if(json.data.user.roleId == '管理员')
                                window.location.href = "../Login/Main";                               
                            else
                                window.location.href = "../Login/Main";                               

                            loginSuccess = 1;
                        }
                        else {
                            layer.alert(json.msg);
                            GetCaptchaShow();
                        }
                    }
                 });
            });
        });
    </script>
</head>
<body>
    <!--[if lte IE 9]>
             <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="https://browsehappy.com/">upgrade your browser</a> to improve your experience and security.</p>
