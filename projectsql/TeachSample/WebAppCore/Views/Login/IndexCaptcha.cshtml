<!--[if (gt IE 9)|!(IE)]><!-->
<html lang="en" class="no-js">
<!--<![endif]-->
<head>
    <meta charset="UTF-8" />
    <!-- <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">  -->
    <title>登录</title>
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <!-- The above 3 meta tags *must* come first in the head; any other head content must come *after* these tags -->
    <!-- title of site -->
    <title>Sign up</title>

    <!-- For favicon png -->
    <link rel="shortcut icon" type="image/icon" href="~lib/login-new/images/favicon.png" />

    <!--font-awesome.min.css-->
    <link rel="stylesheet" href="~/lib/login-new/css/font-awesome.min.css">

    <!--animate.css-->
    <link rel="stylesheet" href="~/lib/login-new/css/animate.css">

    <!--bootstrap.min.css-->
    <link rel="stylesheet" href="~/lib/login-new/css/bootstrap.min.css">

    <!-- bootsnav -->
    <link rel="stylesheet" href="~/lib/login-new/css/bootsnav.css">

    <!--style.css-->
    <link rel="stylesheet" href="~/lib/login-new/css/style.css">

    <!--responsive.css-->
    <link rel="stylesheet" href="~/lib/login-new/css/responsive.css">
    <style>    
        .captcha-container {
            width: 130px;
            height: 45px;
            border: 1px solid #ccc;
            display: flex;
            align-items: center;
        }
         .captcha-image {
            width: auto;
            height: 100%;            
            object-fit: contain;
        }
        </style>

    <!-- HTML5 shim and Respond.js for IE8 support of HTML5 elements and media queries -->
    <!-- WARNING: Respond.js doesn't work if you view the page via file:// -->
    <!--[if lt IE 9]>
        <script src="https://oss.maxcdn.com/html5shiv/3.7.3/html5shiv.min.js"></script>
        <script src="https://oss.maxcdn.com/respond/1.4.2/respond.min.js"></script>
    <![endif]-->
    <script src="~/lib/login-new/js/jquery.js"></script>

    <!--modernizr.min.js-->
    <script src="~/lib/login-new/js/modernizr.min.js"></script>

    <!--bootstrap.min.js-->
    <script src="~/lib/login-new/js/bootstrap.min.js"></script>

    <!-- bootsnav js -->
    <script src="~/lib/login-new/js/bootsnav.js"></script>

    <!-- jquery.sticky.js -->
    <script src="~/lib/login-new/js/jquery.sticky.js"></script>
    <script src="~/lib/login-new/js/jquery.easing.min.js"></script>


    <!--Custom JS-->
    <script src="~/lib/login-new/js/custom.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/old/js/layer.min.js"></script>
    <script src="~/lib/old/js/md5.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/js-cookie@2/src/js.cookie.min.js'></script>
    <script>
        window.onload = function () { 
            refreshCaptcha();            
        }
        function refreshCaptcha() {
                $.ajax({
                    url: "../Login/getCaptcha",
                    type: "GET",
                    async: false,                
                    success: function (data) {
                        var json = $.parseJSON(data);
                         var captcha_img = document.getElementById('captcha_img');
                         captcha_img.src = json.base64Captcha;                         
                        //$("#captcha_img").src = json.base64Captcha;
                    }
                });               
            }
            

            function clickLogin() {
                var UserName = $("#UserName").val();
                var Password = $("#Password").val();
                var Captcha = $("#Captcha").val();
                Password = hex_md5(Password);
                if (UserName == "" || Password == "") {
                    layer.alert("请输入账号密码！");
                    //$("#Info").html("请输入账号密码！");
                }
                else if (Captcha == "") {
                    layer.alert("验证码不能为空！");
                    //$("#Info").html("请输入账号密码！");
                }
                else {
                    $.ajax(
                        {
                            url: "../Login/CheckUserLogin",
                            type: "GET",
                            async: false,
                            data: "userName=" + UserName + "&password=" + Password +'&Captcha='+Captcha+ '&_=' + Math.random(),
                            success: function (data) {
                                var json = $.parseJSON(data);
                                if (json.code == 200) {
                                    //角色设置，临时注释
                                    //Cookies.set('RoleId', json.Id, { expires: 600, path: '/' });
                                    //Cookies.set('RoleId', json.data, { expires: 6000, path: '/' });
                                    //Cookies.set('UserName', UserName, { expires: 6000, path: '/' });

                                    if(json.data == '管理员')
                                        window.location.href = "../Login/Main";
                                    else
                                        window.location.href = "../Login/MainUser";

                                    loginSuccess = 1;
                                
                                }
                                else {
                                    layer.alert(json.msg+"！");
                                    //$("#Info").html("账号或密码错误，请重新输入！");
                                }
                            }
                        });
                }

            }
    </script>
</head>
<body>
    <!--[if lte IE 9]>
             <p class="browserupgrade">You are using an <strong>outdated</strong> browser. Please <a href="https://browsehappy.com/">upgrade your browser</a> to improve your experience and security.</p>
         <![endif]-->
    <!-- signin end -->
    <section class="signin signup popup-in popup-up">
        <div class="container">
            <div class="row">
                <div class="col-sm-12">
                    <div class="single-sign">
                        <div class="sign-content popup-in-content">
                            <div class="popup-in-txt">
                                <h2>登录</h2>

                                <div class="signin-form">
                                    <form action="signin.html">
                                        <div class="form-group">
                                            <label for="signin_form">用户名</label>
                                            @*<input type="email" class="form-control" id="signin_form" placeholder="">*@
                                            <input type="text" class="form-control" id="UserName" placeholder="">
                                        </div><!--/.form-group -->
                                        <div class="form-group">
                                            <label for="signin_form">密码</label>
                                            <input type="password" class="form-control" id="Password" placeholder="">
                                        </div><!--/.form-group -->
                                        <div class="row">
												<div class="col-sm-6" style="width:65%;">
													<div class="form-group">
														<label for="signin_form">验证码</label>
														<input type="text" class="form-control" id="Captcha" placeholder="">
													</div><!--/.form-group -->
												</div><!--/.col -->
												<div class="col-sm-6" style="width:30%;">
                                                    <div class="form-group">
                                                        <label for="signin_form">&nbsp;&nbsp;</label>
													    <div class="captcha-container">
                                                        <img id="captcha_img" class="captcha-image" src="/captcha/" alt="Captcha" onclick="refreshCaptcha()" />
													    </div><!--/.form-group -->
                                                    </div><!--/.form-group -->
												</div><!--/.col -->
											</div><!--/.row -->
                                    </form><!--/form -->
                                    
                                </div><!--/.signin-form -->
                                <div class="signin-footer">                                    
                                    <button type="button" class="btn signin_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickLogin()">
                                        登录
                                    </button>
                                    <p>
                                        没有账户 ? <a href="SignUp">注册</a>
                                    </p>
                                </div><!--/.signin-footer -->
                            </div><!--/.popup-in-txt -->
                        </div><!--/.sign-content -->
                    </div><!--/.single-sign -->
                </div><!--/.col -->
            </div><!--/.row-->
        </div><!--/.container -->
    </section><!--/.signin -->
    <!-- signin end -->
    <!--footer copyright start -->
    <footer class="footer-copyright">
        <div id="scroll-Top">
            <i class="fa fa-angle-double-up return-to-top" id="scroll-top" data-toggle="tooltip" data-placement="top" title="" data-original-title="Back to Top" aria-hidden="true"></i>
        </div><!--/.scroll-Top-->

    </footer><!--/.hm-footer-copyright-->
    <!--footer copyright  end -->
    <!-- Include all js compiled plugins (below), or include individual files as needed -->

    
</body>
</html>
