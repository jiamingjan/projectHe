@{
    /**/

    ViewBag.Title = "ShowUserPanel";
    Layout = "~/Views/Shared/_Layout_Old.cshtml";
}

@using WebAppCore.ViewModels
@using System.Collections.Generic

@section CSS{
    <link href="~/lib/old/css/style.css" rel="stylesheet" />
    <link href="~/lib/old/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/old/css/animate.css" rel="stylesheet" />
    <link href="~/lib/old/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/lib/old/js/plugins/layer/skin/layer.css" rel="stylesheet" />
    <link href="~/lib/old/js/plugins/bootstrap-select/dist/css/bootstrap-select.min.css" rel="stylesheet" />
    <style>
        body {
            padding: 10px 20px;
            width: 100%;
            height: 100%;
        }


        label.xreuired before {
            content: '* ';
            color: red;
        }

        table, tr, td {
            width: 100%;
            border: 1px solid #B3B4BA;
            padding-left: 5px;
            font-size: 12px;
            font-weight: 500;
        }

        tr {
            height: 40px;
        }

        td {
            width: 25%;
            text-align: left;
        }

            td:nth-child(odd) {
                background: #f9f9f9;
            }
