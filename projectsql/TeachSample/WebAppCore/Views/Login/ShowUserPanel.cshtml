}
@section JS{
    <script src="~/lib/old/js/plugins/layer/laydate/laydate.js"></script>
    <script src="~/lib/old/js/md5.js"></script>
    <script src="~/lib/old/js/plugins/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/lib/old/js/MyTool.js"></script>
    <script src="~/lib/old/js/jquery.min.js"></script>
    <script src="~/lib/old/js/bootstrap.min.js"></script>
    <script src="~/lib/old/js/jquery-ui-1.10.4.min.js"></script>
    <script src="~/lib/old/js/jquery-ui.custom.min.js"></script>
    <script src="~/lib/old/js/content.js"></script>
    <script>
        //启动页面执行
        $(document).ready(function () {
            //获取子表数据（下拉）
            //initSelectControl();

            //初始化一些特殊控件
            //initSpecialControl();
            // $(".btn").dropdown();
        });



        $('#cancelBtn').bind('click', function () {

        });

        //检查必填项是否填上
        function CheckRequired() {
            if ($('#UserName').val() == "" || $('#UserName').val() == null) {
                layer.msg('用户名不能为空！', { icon: 5, time: 2000 });
                //alert("用户名不能为空");
                return false;
            }
            if ($('#Password').val() == "" || $('#Password').val() == null) {
                layer.msg('密码不能为空！', { icon: 5, time: 2000 });
                return false;
            }
        }


        $('#saveBtn').bind('click', function () {
            var tool = new MyTool();
            var id = tool.getUrlParam("id");
            var url;
            var opr;

            if (CheckRequired() == false)
                return;

            var Password = $("#Password").val();
            //这里如果小于20表示是自己设置的密码，否则是从数据库里查询的md5加密过的密码，就不需要再加密了
            if (Password != null && Password.length <= 20)  //加过密的32位
                Password = hex_md5(Password);
            $("#Password").val(Password);//这个要有，下面的语句读的就是重新赋值后的
            var param = $("#contentForm").serialize();
            //下拉框的数据不在param里面，需要手动添加，什么方法能自动添加呢？
            //param = param + "&UserRole=" + $("#UserRole").val(); //val()获取的值，不是text

            if (id == null || id == "0") {
                url = "AddTableData";//insert
                opr = "新增";
            }
            else {
                url = "UpdateTableData";//update
                param = param + "&id=" + id; //添加id
                opr = "修改";
            }
            $.ajax(
                {
                    url: url,
                    type: "GET",
                    async: false,
                    data: param,
                    success: function (data) {
                        var json = $.parseJSON(data);
                        if (json.result == 'success') {
                            layer.msg(opr + '成功！', { icon: 1, time: 2000 });
                            parent.$('#searchBtn').click(); //刷新表格
                        }
                        else {
                            layer.msg(opr + "失败！", { icon: 2, time: 2000 });
                            // $("#Info").html("删除失败");
                        }
                    }
                });
        });
    </script>
}

@section Body{
    <body class="gray-bg">
        <div class="wrapper wrapper-content animated fadeInRight">
            <div class="row">
                @*<div class="col-sm-6">*@
