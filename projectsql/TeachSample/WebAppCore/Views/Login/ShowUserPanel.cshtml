                                <div class="col-sm-10">
                                    <input class="form-control" id="Phone" name="Phone" type="text" value="@DetailData.phone">
                                </div>
                            </div>
                           @* <div class="form-group">
                                <label class="col-sm-2 control-label">部门</label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="Department" name="Department" type="text" value="@DetailData.Department">
                                </div>
                            </div>
                            <div class="form-group">
                                <label class="col-sm-2 control-label">微信或QQ</label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="InstantMsg" name="InstantMsg" type="text" value="@DetailData.InstantMsg">
                                </div>
                            </div>*@
                            <div class="form-group">
                                <label class="col-sm-2 control-label">邮箱</label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="Email" name="Email" type="text" value="@DetailData.email">
                                </div>
                            </div>
                            @*<div class="form-group">
                                <label class="col-sm-2 control-label">备注</label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="Memo" name="Memo" type="text" value="@DetailData.Memo">
                                </div>
                            </div>*@
                            <div class="form-group">
                                <label class="col-sm-2 control-label"></label>
                                <div class="col-sm-10">
                                    <button type="button" id="saveBtn" class="btn btn-w-m btn-success" style="margin-left: 0px;">
                                        <span class="glyphicon glyphicon-floppy-disk" aria-hidden="true"></span> 保  存
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
                @*</div>*@
            </div>
        </div>
    </body>
}
