                            <div class="form-group" style="display:none;">
                                <label class="col-sm-2 control-label">密码<span style="color:red;">* </span></label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="Password" name="Password" type="password" value="@DetailData.password">
                                </div>
                            </div>
                            
                            <div class="form-group">
                                <label class="col-sm-2 control-label">昵称</label>
                                <div class="col-sm-10">
                                    <input class="form-control" id="NickName" name="NickName" type="text" value="@DetailData.nickName">
                                </div>
                            </div>
                            <div class="form-group">
