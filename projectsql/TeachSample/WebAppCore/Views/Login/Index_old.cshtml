@{
    ViewBag.Title = "Index";
    Layout = null;
}

<!DOCTYPE html>
<!--[if lt IE 7 ]> <html lang="en" class="no-js ie6 lt8"> <![endif]-->
<!--[if IE 7 ]>    <html lang="en" class="no-js ie7 lt8"> <![endif]-->
<!--[if IE 8 ]>    <html lang="en" class="no-js ie8 lt8"> <![endif]-->
<!--[if IE 9 ]>    <html lang="en" class="no-js ie9"> <![endif]-->
<!--[if (gt IE 9)|!(IE)]><!-->
<html lang="en" class="no-js">
<!--<![endif]-->
<head>
    <meta charset="UTF-8" />
    <!-- <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">  -->
    <title>登录</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Login and Registration Form with HTML5 and CSS3" />
    <meta name="keywords" content="html5, css3, form, switch, animation, :target, pseudo-class" />
    <meta name="author" content="Codrops" />
    <link rel="shortcut icon" href="~/images/logo.png">
    <link rel="stylesheet" type="text/css" href="~/lib/old/Login/css/demo.css" />
    <link rel="stylesheet" type="text/css" href="~/lib/old/Login/css/style.css" />
    <link rel="stylesheet" type="text/css" href="~/lib/old/Login/css/animate-custom.css" />
    <link rel="stylesheet" href="~/lib/old/css/bootstrap.min.css" />
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/old/js/layer.min.js"></script>
    <script src="~/lib/old/js/md5.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/js-cookie@2/src/js.cookie.min.js'></script>
    <script>
        function clickLogin() {
            var UserName = $("#UserName").val();
            var Password = $("#Password").val();
            Password = hex_md5(Password);
            if (UserName == "" || Password == "") {
                layer.alert("请输入账号密码！");
                $("#Info").html("请输入账号密码！");
            }
            else {
                $.ajax(
                    {
                        url: "../Login/CheckUserLogin",
                        type: "GET",
                        async: false,
                        data: "userName=" + escape(UserName) + "&password=" + escape(Password) + '&_=' + Math.random(),
                        success: function (data) {
                            var json = $.parseJSON(data);
                            if (json.code == 200) {
                                //角色设置，临时注释
                                //Cookies.set('RoleId', json.Id, { expires: 600, path: '/' });
                                //Cookies.set('RoleId', json.data, { expires: 6000, path: '/' });
                                //Cookies.set('UserName', UserName, { expires: 6000, path: '/' });

                                if(json.data == '管理员')
                                    window.location.href = "../Login/Main";
                                else
                                    window.location.href = "../Login/MainUser";

                                loginSuccess = 1;
                                
                            }
                            else {
                                layer.alert("账号或密码错误！");
                                $("#Info").html("账号或密码错误，请重新输入！");
                            }
                        }
                    });
            }

        }
    </script>
</head>
<body>
    <div style="height: 5%"></div>
    <div class="container">
        <header>
            <h1 style="color:#B3EE3A">浪潮推荐 <span></span></h1>
            <nav class="codrops-demos">
            </nav>
        </header>
        <section>
            <div id="container_demo">
                <a class="hiddenanchor" id="toregister"></a>
                <a class="hiddenanchor" id="tologin"></a>
                <div id="wrapper">
                    <div id="login" class="animate form">
                        <form id="LoginForm" autocomplete="on">
                            <h1>登录</h1>
                            <p>
                                <label for="UserName" class="uname" data-icon="u"> 请输入用户名 </label>
                                <input id="UserName" name="UserName" required="required" type="text" placeholder="用户名" />
                            </p>
                            <p>
                                <label for="Password" class="youpasswd" data-icon="p"> 请输入密码 </label>
                                <input id="Password" name="Password" required="required" type="password" placeholder="******" />
                            </p>
                            <p class="login button">
                                @*<input type="button" value="注册" onclick="clickLogin()" />*@
                                <input type="button" value="登录" onclick="clickLogin()" />
                            </p>
                            <p class="change_link" id="Info" style="color:red;">

                            </p>
                        </form>
                    </div>
                </div>
            </div>
        </section>
    </div>
</body>
</html>
