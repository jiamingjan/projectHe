@section JS{
    <script src="~/lib/old/js/plugins/layer/laydate/laydate.js"></script>
    <script src="~/lib/old/js/plugins/jqgrid/jquery.jqGrid.min.js?0820"></script>
    <script src="~/lib/old/js/layer.min.js"></script>
    <script src="~/lib/old/js/md5.js"></script>
    <script src="~/lib/old/js/plugins/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/lib/old/js/MyTool.js"></script>

    <script src="~/lib/old/js/jquery.min.js"></script>
    <script src="~/lib/old/js/bootstrap.min.js"></script>
    <script src="~/lib/old/js/jquery-ui-1.10.4.min.js"></script>
    <script src="~/lib/old/js/jquery-ui.custom.min.js"></script>
    <script src="~/lib/old/js/content.js"></script>
    <script src="~/lib/old/js/plugins/metisMenu/jquery.metisMenu.js"></script>
    <script src="~/lib/old/js/plugins/slimscroll/jquery.slimscroll.min.js"></script>
    <script src="~/lib/old/js/plugins/validate/jquery.validate.min.js"></script>
    <script src="~/lib/old/js/plugins/validate/messages_zh.min.js"></script>

    <script>
        //启动页面执行
        $(document).ready(function () {

            //初始化一些特殊控件
            //initSpecialControl();
            // $(".btn").dropdown();
        });



        $('#cancelBtn').bind('click', function () {

        });

        //检查必填项是否填上
        function CheckRequired() {
            if ($('#Password').val() != $('#Password2').val()) {
                layer.msg('密码不一致！', { icon: 5, time: 2000 });
                //layer.alert("密码不一致");
                return false;
            }
            if ($('#Password').val() == "" || $('#Password').val() == null) {
                layer.msg('密码不能为空！', { icon: 5, time: 2000 });
                //layer.alert("密码不能为空");
                return false;
            }

            if ($('#Password').val().length > 13) {
                layer.msg('密码太长！', { icon: 5, time: 2000 });
                //layer.alert("密码不能为空");
                return false;
            }
        }


        $('#saveBtn').bind('click', function () {
            var url = "UpdatePwd";
            var opr = '修改密码';

            if (CheckRequired() == false)
                return;

            var Password = $("#Password").val();
            Password = hex_md5(Password);
            //$("#Password").val(Password);//这个要有，下面的语句读的就是重新赋值后的
            //var param = $("#contentForm").serialize();
            var param = "&UserName=" + $("#UserName").val();
            param = param + "&Password=" + Password;

            $.ajax(
                {
                    url: url,
                    type: "GET",
                    async: false,
                    data: param,
                    success: function (data) {
                        var json = $.parseJSON(data);
                        if (json.code == 200) {
                            layer.msg(opr + '成功！', { icon: 1, time: 2000 });
                            //layer.alert(opr + '成功！');
                            parent.$('#searchBtn').click(); //刷新表格
                        }
                        else {
                            layer.msg(opr + "失败！" + json.msg, { icon: 2, time: 2000 });
                            //layer.alert(opr + "失败！");
                            // $("#Info").html("删除失败");
                        }
                    }
                });
        });
    </script>
}

