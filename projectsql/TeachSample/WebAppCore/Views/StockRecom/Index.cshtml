@section JS{
    
    <script src="~/lib/old/js/jquery.min.js"></script>
    <script src="~/lib/old/js/bootstrap.min.js"></script>
    @*<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/lib/old/js/plugins/layer/laydate/laydate.js"></script>
    <script src="~/lib/old/js/plugins/jqgrid/jquery.jqGrid.min.js"></script>
    <script src="~/lib/old/js/fileinput.js"></script>
    <script src="~/lib/old/js/locales/zh.js"></script>
    <script src="~/lib/old/js/MyTool.js"></script>
    <script src="~/lib/old/js/plugins/jqgrid/i18n/grid.locale-cn.js?0820"></script>
    <script>

        $("#input-line").fileinput({
            //上传的地址
            uploadUrl: "UploadStockFile",
            language: 'zh', //设置语言
            showCaption: false,
            enctype: 'multipart/form-data',
            dropZoneEnabled: false,
            allowedFileExtensions: ['xlsx', 'xls']//接收的文件后缀,            
        }).on("fileuploaded", function (event, data, previewId, index) {
            if (data.response.result != "right") {
                alert(data.response.result);
            }
            else{
                alert("上传成功，数量："+data.response.num);
            }


            });

        function StockTable() {                    
            var isSearch = false;       //用于设置是否点击了搜索按钮，不然初始化中的总计值会覆盖搜索中的总计功能。
            
            this.initSearch = function () {
                $('#searchBtn').bind('click', function () {
                    isSearch = true;
                    var data = $("#searchForm").serialize();                    
                    $("#table_Stock").jqGrid('clearGridData');  //清空表格
                    $("#table_Stock").jqGrid('setGridParam', {  // 重新加载数据
                        url: 'GetTableData?' + data,//请求数据的地址
                        data: data,   //  newdata 是符合格式要求的需要重新加载的数据

                    }).trigger("reloadGrid");                    
                });
                $('#clearBtn').bind('click', function () {
                    $('#stockCode').val("");
                    $('#stockName').val("");
                    $('#stockField').val("");
                    $('#stockDate').val("");
                    $('#startTime').val("");
                    $('#endTime').val("");
                });
            };

            this.initTable = function () {
                // alert();
                var tableHeight = $(window).height() - 260;
                $.jgrid.defaults.styleUI = 'Bootstrap';
                var url = 'GetTableData';// + '?department=' + department + '&device_key=' + device_key + '&projectcode=' + projectcode + '&warning=' + warning;
                //var url = 'GetTableData';
                //var url = 'GetTableOnloadData?RegionNo=' + RegionNo_Onload;
                // Examle data for jqGrid
                // Configuration for jqGrid Example 2
                $("#table_Stock").jqGrid({
                    regional: 'cn',
                    url: url,//请求数据的地址
                    datatype: "json",// 服务器返回的数据类型，常用的是xml和json两种
                    height: tableHeight,
                    autowidth: true,
                    shrinkToFit: true,
                    rowNum: 20,// 默认的每页显示记录条数
                    rowList: [10, 20, 30],// 可供用户选择的每页显示记录条数。
                    rownumbers: true,//是否显示右
                    colNames: ['Id', '股票代码', '股票名称', '行业', '总分', '产生日期', '上传日期'],
                    colModel: [
                        {
                            name: 'Id',
                            index: 'Id',
                            key: true,
                            hidden: true
                        },
                        {
                            name: 'StockCode',
                            index: 'StockCode',
                            width: 40,
                            sortable: false
                        },
                        {
                            name: 'StockName',
                            index: 'StockName',
                            width: 40,
                            sortable: false
                        },
                        {
                            name: 'StockField',
                            index: 'StockField',
                            width: 40,
                            sortable: false
                        },
                        {
                            name: 'StockScore',
                            index: 'StockScore',
                            width: 15,
                            sortable: false
                        },                       
                        {
                            name: 'StockDate',
                            index: 'StockDate',
                            width: 40,
                            sortable: false
                        },                        
                        {
                            name: 'UpdateTime',
                            index: 'UpdateTime',
                            width: 50,
                            sortable: true,
                        }
                    ],

                    pager: "#pager_Stock",// 导航条对应的Div标签的ID,注意一定是DIV，不是Table
                    viewrecords: true,// 定义是否在导航条上显示总的记录数
                    hidegrid: false,
                    multiselect: true,
                    //caption : "", // 显示表格的表名称
                    //toolbar : [true, "top"],//表格头上的一行白的
                    editurl: "/RowEditing",//editurl: "DeleteTableData", //没起作用
                    //cellurl: "${pageContext.request.contextPath}/order/editEntity.shtml",
                    gridComplete: function () {
                        //var ids = $("#table_Yanghu").getDataIDs();
                        //for (var i = 0; i < ids.length; i++) {
                        //    var rowData = $("#table_Yanghu").getRowData(ids[i]);
                        //    if (rowData.Color != "black") {//如果审核不通过，则背景色置于红色
                        //        $('#' + ids[i]).find("td").css("background-color", rowData.Color);
                        //        $('#' + ids[i]).find("td").css("color", "black");
                        //    }
                        //}
                    }
                });


                //下面是隐藏多选中的全选//
                //var myGrid = $("#table_JiaoBanZhuang");
                //$("#cb_" + myGrid[0].id).hide();

                // Add responsive to jqGrid
                $(window).bind('resize', function () {
                    var width = $('.jqGrid_wrapper').width();
                    $('#table_Stock').setGridWidth(width);
                });
            };

            this.initPager = function () {
                // Setup buttons
                $("#table_Stock").jqGrid('navGrid', '#pager_Stock', {
                    edit: false,
                    add: false,
                    del: false,
                    search: false
                },
                    {
                        height: 200,
                        reloadAfterSubmit: true
                    });
            };
                       
            //添加
            this.initEvent = function () {
                $("#editBtn").click(function () {
                    var rowids = jQuery("#table_Stock").jqGrid('getGridParam', 'selarrrow');
                    //alert(rowid);
                    if (rowids == null || rowids == 'undefined' || rowids.length != 1)
                        layer.msg('请先选中一行!', { icon: 5, time: 2000 });
                    else {
                        var url1 = 'EditDataPanel?Id=' + rowids[0];
                        var content1 = '<iframe id="ifr" src="' + url1 + '"  frameborder="no" border="0" "></iframe>';

                        //页面层
                        //tab层
                        layer.tab({
                            area: ['900px', '480px'],
                            tab: [{
                                title: '修改股票信息',
                                content: content1
                            }]
                        });
                    }
                });
                $('#deleteBtn').bind('click', function () {
                    var rowids = jQuery("#table_Stock").jqGrid('getGridParam', 'selarrrow');
                    //alert(rowid);
                    if (rowids == null || rowids == 'undefined' || rowids.length == 0)
                        layer.msg('请先选中要删除的行', { icon: 5, time: 2000 });
                    else {
                        //做删除
                        layer.confirm('确定要删除选中的行？注意删除后不可恢复！', { btn: ['确定', '取消'], title: "提示" }, function () {
                            //var rowDatas = $("#table_Stock").getRowData();//所有的数据
                            var Ids = rowids;

                            $.ajax({
                                
                                url: "DeleteTableData",
                                type: "GET",
                                async: false,
                                data: "Ids=" + escape(Ids),
                                success: function (data) {
                                    var json = $.parseJSON(data);
                                    if (json.code == 200) {
                                        layer.msg('删除' + json.msg + '行成功！', { icon: 1, time: 2000 });
                                            
                                        var search = $("#searchForm").serialize();
                                        $("#table_Stock").jqGrid('setGridParam', {  // 重新加载数据
                                            url: 'GetTableData?' + search,//请求数据的地址
                                            data: search,   //  newdata 是符合格式要求的需要重新加载的数据
                                        }).trigger("reloadGrid");
                                    }
                                    else {
                                        layer.msg('删除失败：'+json.msg, { icon: 2, time: 2000 });
                                    }
                                }
                            });

                        });
                    }
                });

                $('#deleteSearchBtn').bind('click', function () {     
                    if ($('#stockCode').val() == '' && $('#stockName').val() == '' && $('#stockField').val() == ''
                        && $('#stockDate').val() == '' && $('#startTime').val() == '' && $('#endTime').val() == '')
                        layer.msg('没有查询条件，请先输入查询条件', { icon: 5, time: 2000 });
                    else {
                        //做删除
                        layer.confirm('注意删除后不可恢复！确定要删除所选条件的记录？', { btn: ['确定', '取消'], title: "提示" }, function () {
                            
                            var param = $("#searchForm").serialize();

                            $.ajax({
                                url: "DeleteSearchData",
                                type: "GET",
                                async: false,
                                data: param,
                                success: function (data) {
                                    var json = $.parseJSON(data);
                                    if (json.code == 200) {
                                        layer.msg('删除' + json.msg + '行成功！', { icon: 1, time: 2000 });

                                        var search = $("#searchForm").serialize();
                                        $("#table_Stock").jqGrid('setGridParam', {  // 重新加载数据
                                            url: 'GetTableData?' + search,//请求数据的地址
                                            data: search,   //  newdata 是符合格式要求的需要重新加载的数据
                                        }).trigger("reloadGrid");
                                    }
                                    else {
                                        layer.msg('删除失败:'+json.msg, { icon: 2, time: 2000 });
                                    }
                                }
                            });

                        });
                    }
                });
            };
        }

        $(document).ready(function () {
            var tool = new MyTool();            
            var stock = new StockTable();           
            stock.initSearch();
            stock.initTable();
            stock.initPager();
            stock.initEvent();
        });
       
    </script>
}

@section Body{
    <body>
        <div class="form-group">
            <label for="input-line">股票数据导入：(必须是Excel文件：'.xlsx', '.xls')</label>
            <input id="input-line" name="input-line" multiple type="file" class="file" />
        </div>
        <br />

        <div class="wrapper wrapper-content  animated fadeInRight" style="padding-bottom:0px; padding:0px;">
            <div class="row">
                <div class="col-sm-12">
                    <div class="ibox " style="margin-bottom:0px;">
                        <div class="ibox-title">
                            <h5>股票数据</h5>
                        </div>
                        <div class="ibox-content" style="padding-bottom:10px;">

                            <form class="form-inline" id="searchForm">                            
                                <div class="form-group">
                                    <label for="customer">代码：</label>
                                    <input type="text" class="form-control" id="stockCode" name="stockCode" width="20pt">
                                </div>
                                <div class="form-group">
                                    <label for="customer">名称：</label>
                                    <input type="text" class="form-control" id="stockName" name="stockName">
                                </div>
                                <div class="form-group">
                                    <label for="customer">行业：</label>
                                    <input type="text" class="form-control" id="stockField" name="stockField">
                                </div>
                                <div class="form-group">
                                    <label for="customer">产生日期：</label>
                                    <input type="text" class="form-control" id="stockDate" name="stockDate">
                                </div>

                                <div class="form-group">
                                    <label for="startTime">上传时间：</label>
                                    <input readonly class="form-control layer-date" placeholder="查询起始" id="startTime" name="startTime">
                                    <label class="laydate-icon inline demoicon" style="vertical-align:top;"
                                           onclick="laydate({elem: '#startTime',istime: true,format: 'YYYY-MM-DD hh:mm:ss'});"></label>

                                </div>

                                <div class="form-group">
                                    <input readonly class="form-control layer-date" placeholder="查询结束" style="margin-left:30px;" id="endTime" name="endTime">
                                    <label class="laydate-icon inline demoicon" style="vertical-align:top;"
                                           onclick="laydate({elem: '#endTime',istime: true,format: 'YYYY-MM-DD hh:mm:ss'});"></label>

                                </div>

                                <div class="form-group">
                                    @*<button type="button" id="clearBtn" class="btn btn-w-m btn-info" style="margin-left: 50px;">清空</button>*@
                                    <button type="button" id="clearBtn" class="btn btn-w-m btn-info" style="margin-left: 50px;">清空</button>
                                    <button id="searchBtn" type="button" class="btn btn-w-m btn-success" style="margin-left: 10px;">搜索</button>

                                </div>
                            </form>


                            <div class="jqGrid_wrapper"> 
                                <div style="font-weight:600;text-align:right; float:right"></div>
                                <div class="list-op" id="list_op">
                                    <button type="button" id="addBtn" class="btn btn-default btn-success">
                                        <span class="glyphicon glyphicon-plus" aria-hidden="true"></span>新增
                                    </button>
                                    <button type="button" id="editBtn" class="btn btn-default btn-warning">
                                        <span class="glyphicon glyphicon-pencil" aria-hidden="true"></span>修改
                                    </button>
                                    <button type="button" id="deleteBtn" class="btn btn-default btn-danger">
                                        <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>删除选中
                                    </button>
                                    <button type="button" id="deleteSearchBtn" class="btn btn-default btn-danger">
                                        <span class="glyphicon glyphicon-remove" aria-hidden="true"></span>搜索条件删除
                                    </button>

                                  @*  <button type="button" id="rightBtn" class="btn btn-default btn-primary">
                                        <span class="glyphicon glyphicon-ok-sign" aria-hidden="true"></span>授权
                                    </button>*@
                                   
                                </div>
                                <table id="table_Stock"></table>
                                <div id="pager_Stock"></div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>
        </div>
    </body>
}
