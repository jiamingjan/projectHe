@{
    /**/

    ViewBag.Title = "股票及上传";
    //Layout = "~/Views/Shared/_Layout_Old.cshtml";
    Layout = "~/Views/Shared/_tableLayout_Old.cshtml";
}

@section CSS{
    <meta charset="UTF-8" />
    <title></title>  
        @*注意bootstrap.min.css必须要用下面行*@
    <link rel="stylesheet" href="~/lib/old/css/bootstrap.min.css" />    
    <link rel="stylesheet" href="~/lib/old/css/fileinput.min.css" />
    @*<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/WebAppCore.styles.css" asp-append-version="true" />*@
    <style>
        
        .layui-layer-tab .layui-layer-content {
            position: absolute !important;
            left: 0px !important;
        }

        .layui-layer-tab .layui-layer-tabmain {
            padding: 0px;
        }

        iframe {
            width: 820px;
            height: 600px;
        }

        /*iframe {
                    width: 600px;
                    height: 360px;
                }*/


        .form-group {
            margin-right: 30px;
            margin-bottom: 15px;
        }

            .form-group label {
                margin-right: 10px;
            }

        
    </style>
