@{
    /**/
    ViewBag.Title = "Cesium智慧地图"; //页面title
    Layout = "~/Views/Shared/_Layout_Old.cshtml"; //通用的排版
}


@section CSS {
	<!-- 引用样式库，要用link标签 CSS -->
	<link href="~/lib/old/css/waitimg.css" rel="stylesheet" />
	<link href="~/lib/old/css/style.css" rel="stylesheet" />
	<link href="~/lib/old/css/bootstrap.min.css" rel="stylesheet" />
	<link href="~/lib/old/css/animate.css" rel="stylesheet" />
	<link href="~/lib/old/css/font-awesome.min.css" rel="stylesheet" />
	<link href="~/lib/old/css/fileinput.min.css" rel="stylesheet" />	
	<!-- Cesium CSS -->
	<link href="https://cesium.com/downloads/cesiumjs/releases/1.83/Build/Cesium/Widgets/widgets.css" rel="stylesheet">
	
	<!-- 自定义样式 要写在style内-->
	<style>
		body {
			padding: 10px 20px;
			width: 100%;
			height: 100%;
		}
		label.xreuired before {
			content: '* ';
			color: red;
		}
	</style>
}
@section JS {
	<!-- 用到的JavaScript脚本库 用script标签 -->
	<script src="~/lib/old/js/plugins/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/lib/old/js/jquery.min.js"></script>
    <script src="~/lib/old/js/bootstrap.min.js"></script>
    <script src="~/lib/old/js/jquery-ui-1.10.4.min.js"></script>
    <script src="~/lib/old/js/jquery-ui.custom.min.js"></script>
    <script src="~/lib/old/js/content.js"></script>
	<script src="~/lib/old/js/fileinput.js"></script>
	<script src="~/lib/old/js/locales/zh.js"></script>
	<script src="~/lib/old/js/bootstrap-waitingfor.min.js"></script>	
	<script src="~/lib/old/js/MyTool.js"></script>
	
	<!-- Cesium JavaScript -->	
	<script src="https://cesium.com/downloads/cesiumjs/releases/1.83/Build/Cesium/Cesium.js"></script>

	<!-- 用于本页面的自己写的脚步 -->
    <script>	
		//下面是文件上传
		 $("#input-image").fileinput({
			//上传的地址
			uploadUrl: "UploadFile",
			language: 'zh', //设置语言
			showCaption: false,
			enctype: 'multipart/form-data',
			dropZoneEnabled: false,
			allowedFileExtensions: ['jpg', 'png'],//接收的文件后缀,
			beforeSend: function(previewId, index) {   //额外参数的关键点
				alert("hello");
			},
			uploadExtraData: function(previewId, index) {   //额外参数的关键点
				var param = {};
				param.question = $("#question").val();
				return param;
			}
		}).on("fileuploaded", function (event, data, previewId, index) {
			//上传后的返回结果处理
			if(data != null && data.response != null)
			{
				$("#response").val(data.response.data);				
			}
			else
				$("#response").val("出错："+data.response);	
		});

		//查询AI
		function AskAi(company, model, question)
		{
			//等待
			// waitingDialog.show('等待结果...', {
			// 	dialogSize: 'sm',  // 对话框大小：sm - 小, m - 正常, lg - 大
			// 	progressType: 'success'  // 进度条类型：success, danger, warning
			// });			
			document.getElementById("waitimg").style.display = "block";//显示
			//访问后台
			$.ajax({
				url: "../AiApp/AiChatReq",//后台地址
				type: "GET",
				async: true, //false是同步
				data: "company="+company+"&model="+model+"&question=" + question, //传递参数
				//headers: {'Authorization': `Bearer ${localStorage.getItem('token')}`},
				headers: new MyTool().getAuthHeader(),
				success: function (data) {
					//返回结果处理
					var json = $.parseJSON(data);
					if (json.code == 200) {
						$("#response").val(json.data);
					}
					else {
						$("#response").val(json.code +"," +json.msg+json.data);;
					}

					//返回结果以后停止等待
					//waitingDialog.hide();					
					document.getElementById("waitimg").style.display="none";//隐藏
				}
			});
		}

		//点击消息处理
		function clickSearch(company, model) {
			var question = $("#question").val();
			AskAi(company, model, question)
		}

		//页面启动后进入下面函数
		$(document).ready(function() {
			Cesium.Ion.defaultAccessToken = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJqdGkiOiI5YmU3MThmZi02Y2FhLTQyYTAtOTQ0Zi01NzA4N2U4YzQ1ZGMiLCJpZCI6NDYwNzYsImlhdCI6MTYxNTgyNzA4Nn0.xEuHEPrEGJnmFCIgk4k5KAZz99ogOWOt4hVJ7dAj1cI';
			var viewer = new Cesium.Viewer('cesiumContainer', {
				// 配置选项，例如是否显示底图等
				terrainProvider: Cesium.createWorldTerrain() // 加载地形数据
			});
			
			//天地图
			const tiandituVector = new Cesium.UrlTemplateImageryProvider({//cia_w cva_w img_w cia_w vec_w ter_w cta_w
				url: "https://t{s}.tianditu.gov.cn/DataServer?T=cva_w&x={x}&y={y}&l={z}&tk=25129831bd91c81af49d3ecf578f6b3c",
				subdomains: ['0','1','2','3','4','5','6','7'],
				tilingScheme: new Cesium.WebMercatorTilingScheme(),
				maximumLevel: 18
			});

			//高德地图
			const gaodeVector = new Cesium.UrlTemplateImageryProvider({
				url: "https://webrd01.is.autonavi.com/appmaptile?lang=zh_cn&size=1&scale=1&style=8&x={x}&y={y}&z={z}",
				name: "高德矢量地图",
			});

			//Arcgis地图
			const arcGISVector = new Cesium.WebMapTileServiceImageryProvider({
				url: "https://services.arcgisonline.com/arcgis/rest/services/World_Street_Map/MapServer/WMTS",
				layer: "World_Imagery",
				style: "default",
				format: "image/jpeg",
				tileMatrixSetID: "GoogleMapsCompatible",
				maximumLevel: 19,
				credit: new Cesium.Credit("© Esri", "https://www.esri.com/"),
			});

			//百度地图，有问题
			// const baiduVector = new CustomBaiduImageryProvider({
			// 	url: "http:online{s}.map.bdimg.com/onlinelabel/?qt=tile&x={x}&y={y}&z={z}&styles=pl&scaler=1&p=1",
			// });

			//把创建的地图加入到Cesium
			viewer.imageryLayers.addImageryProvider(tiandituVector);

					// 加载中国人口数据（GeoJSON）
		Cesium.GeoJsonDataSource.load("https://geo.datav.aliyun.com/areas_v3/bound/100000_full.json")
			.then(function(dataSource) {
				viewer.dataSources.add(dataSource);
				var entities = dataSource.entities.values;

				// 模拟人口数据（可替换为你自己的后台返回数据）
				var populationData = {
					"北京市": 2154,
					"天津市": 1386,
					"河北省": 7556,
					"山西省": 3718,
					"内蒙古自治区": 2534,
					"辽宁省": 4359,
					"吉林省": 2704,
					"黑龙江省": 3773,
					"上海市": 2424,
					"江苏省": 8051,
					"浙江省": 5737,
					"安徽省": 6324,
					"福建省": 3941,
					"江西省": 4648,
					"山东省": 10047,
					"河南省": 9605,
					"湖北省": 5917,
					"湖南省": 6644,
					"广东省": 11521,
					"广西壮族自治区": 5013,
					"海南省": 1008,
					"重庆市": 3205,
					"四川省": 8367,
					"贵州省": 3856,
					"云南省": 4721,
					"西藏自治区": 344,
					"陕西省": 3953,
					"甘肃省": 2637,
					"青海省": 603,
					"宁夏回族自治区": 720,
					"新疆维吾尔自治区": 2585
				};

				// 着色显示不同人口密度
				for (var i = 0; i < entities.length; i++) {
					var entity = entities[i];
					var name = entity.properties.name.getValue();

					// 根据人口大小设置颜色
					var pop = populationData[name] || 0;
					var color = Cesium.Color.fromHsl(0.6 - (pop / 12000), 1.0, 0.5, 0.6);
					entity.polygon.material = color;
					entity.polygon.outline = true;
					entity.polygon.outlineColor = Cesium.Color.WHITE;

					// 显示省份名称和人口
					entity.description = `
						<table class="cesium-infoBox-defaultTable">
							<tr><th>省份</th><td>${name}</td></tr>
							<tr><th>人口 (万)</th><td>${pop}</td></tr>
						</table>`;
				}

				viewer.flyTo(dataSource);
			})
			.otherwise(function(error){
				console.error("加载人口数据失败:", error);
			});


			//处理鼠标点击消息
			var scene = viewer.scene;
			var handler = new Cesium.ScreenSpaceEventHandler(scene.canvas);
			handler.setInputAction(function(movement) {
				var cartesian = scene.camera.pickEllipsoid(movement.position, scene.globe.ellipsoid);
				if (cartesian) {
					//获取点击坐标
					var cartographic = Cesium.Cartographic.fromCartesian(cartesian);
					//坐标转换为经纬度
					var longitude = Cesium.Math.toDegrees(cartographic.longitude);
					longitude = longitude.toFixed(8);
					var latitude = Cesium.Math.toDegrees(cartographic.latitude);
					latitude = latitude.toFixed(8);
					var height = cartographic.height;					
					console.log('Longitude: ', longitude, 'Latitude: ', latitude, 'Height: ', height);

					//把经纬度显示到问题输入
					$("#question").val("经纬度" + longitude + "," + latitude);		
				} else {
					console.log('No object picked.');
				}
			}, Cesium.ScreenSpaceEventType.LEFT_CLICK); // LEFT_CLICK左击，或者使用其他事件类型，如 MOUSE_MOVE 等。
		});
    </script>
}

<!-- 页面元素排版 -->
@section Body {
    <body class="gray-bg">
		<div class="container-fluid">
			<!-- 页面看成一行 -->
			<div class="row">
				<!-- 一行中的左侧一列，样式col-md-8，会占用比较多，里面的内容是Cesium地图容器 -->
				<div class="col-md-8">
					<div id="cesiumContainer" style="width: 100%; height: 100vh;"></div>
				</div>
				<!-- 一行中的右侧一列，样式col-md-4，会占用比较窄，里面的内容是AI各种按钮输入输出等 -->
				<div class="col-md-4">
					<!-- 智能助手输入区域 -->
					<div class="p-3 border bg-light">
						<h4>智能地图助手</h4>
						<textarea type="text" class="form-control" id="question" rows="2" cols="50" placeholder="输入问题"></textarea>
						<!-- 查询按钮 -->
						<button type="button" class="btn search_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickSearch(0,0)">
							问DeepSeek
						</button>
						<button type="button" class="btn qwen_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickSearch(1,0)">
							问阿里千问
						</button>
						<button type="button" class="btn gpt_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickSearch(2,0)">
							问Gpt
						</button>
						<img id="waitimg" class="waitimg" src="~/lib/old/Images/wait.jpg" style="display:none" />
					</div>

					<!-- 图片上传控件 -->
					<div class="form-group">
						<label for="input-image">图片导入：(必须是图片文件：'.jpg', '.png')</label>
						<input id="input-image" name="input-image" multiple type="file" class="file" />
					</div>
					<!-- 查询结果显示 -->
					<div class="form-group">
						<label for="signin_form">结果</label>
						<textarea type="text" class="form-control" id="response" rows="35" cols="50" placeholder=""></textarea>
					</div><!--/.form-group -->
				</div>
			</div>
		</div>
    </body>
}
