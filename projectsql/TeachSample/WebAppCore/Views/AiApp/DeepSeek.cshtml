@{
    /**/

    ViewBag.Title = "我的DeepSeek";
    Layout = "~/Views/Shared/_Layout_Old.cshtml";
}


@section CSS {
    <link href="~/lib/old/css/style.css" rel="stylesheet" />
    <link href="~/lib/old/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/lib/old/css/animate.css" rel="stylesheet" />
    <link href="~/lib/old/css/font-awesome.min.css" rel="stylesheet" />
    
    <style>
        body {
            padding: 10px 20px;
            width: 100%;
            height: 100%;
        }


        label.xreuired before {
            content: '* ';
            color: red;
        }

        table, tr, td {
            width: 100%;
            border: 1px solid #B3B4BA;
            padding-left: 5px;
            font-size: 12px;
            font-weight: 500;
        }

        tr {
            height: 40px;
        }

        td {
            width: 25%;
            text-align: left;
        }

            td:nth-child(odd) {
                background: #f9f9f9;
            }
    </style>
}
@section JS {
    <script src="~/lib/old/js/plugins/bootstrap-select/dist/js/bootstrap-select.min.js"></script>
    <script src="~/lib/old/js/jquery.min.js"></script>
    <script src="~/lib/old/js/bootstrap.min.js"></script>
    <script src="~/lib/old/js/jquery-ui-1.10.4.min.js"></script>
    <script src="~/lib/old/js/jquery-ui.custom.min.js"></script>
    <script src="~/lib/old/js/content.js"></script>

    <script>
        //type == 1 是chat模型  2 reason模型
        function clickSearch(model) {
            var question = $("#question").val();
            $.ajax({
                url: "../AiApp/DeepSeekReq",
                type: "GET",
                async: false,
                data: "model="+model+"&question=" + question,
                success: function (data) {
                    var json = $.parseJSON(data);
                    if (json.code == 200) {
                        $("#response").val(json.data);
                    }
                    else {
                        $("#response").val(json.code +"," +json.msg+json.data);;
                    }
                }
            });
        }        
    </script>
}

@section Body {
    <body class="gray-bg">
        <div class="wrapper wrapper-content animated fadeInRight">
            <div class="container">  
                <h3 style="text-align:center">DeepSeek</h3>
                <form action="">
                    <div class="form-group">
                        <label for="signin_form">问题</label>
                        <textarea type="text" class="form-control" id="question" rows="15" cols="50" placeholder="输入问题"></textarea>
                    </div><!--/.form-group -->
                    <div class="signin-footer">
                        <button type="button" class="btn search_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickSearch(0)">
                            搜索
                        </button>
                        <button type="button" class="btn reason_btn" data-toggle="modal" data-target=".signin_modal" onclick="clickSearch(1)">
                            思考
                        </button>
                    </div><!--/.signin-footer -->
                    <br />
                    <div class="form-group">
                        <label for="signin_form">结果</label>
                        <textarea type="text" class="form-control" id="response" rows="15" cols="50" placeholder=""></textarea>
                    </div><!--/.form-group -->
                </form><!--/form -->
            </div><!--/.container -->
        </div>
    </body>
}
