                            { field: 'phone', title: columnName['phone'], editRender: { name: 'input' } },
                            { field: 'email', title: columnName['email'], editRender: { name: 'input' } },
                            { field: 'sex', title: columnName['sex'], editRender: { name: 'input' } },
                            { field: 'roleIds', title: columnName['roleIds'], visible: true, sortable: true, editRender: { name: 'input' } },

