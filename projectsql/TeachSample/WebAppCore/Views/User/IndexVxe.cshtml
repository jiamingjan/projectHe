                                                    //Vue.$XModal.message({ message: `成功删除 ${data.msg} 条记录！`, status: 'success' })
                                                    this.$refs.xGrid.commitProxy('query')// 刷新表格                                                    
                                                }
                                                else
                                                    Vue.$XModal.message({ message: `删除失败：${data.msg}！`, status: 'error' })

                                            }).catch(() => {
                                                Vue.$XModal.message({ message: '删除失败！', status: 'error' })
                                            })
                                        }                                        
                                    }
                                },
                                //add he update 都在这里  async 和 await组合产生同步的效果，去掉这2个关键词，默认就是异步
                                save: async ({ body }) => {
                                    //做修改
                                    if (body != 'undefined') {
                                        if (body.updateRecords.length > 0) {
                                            var list = body.updateRecords;
                                            if (list != null && list != 'undefined' && list.length > 0)
                                                //下面用axios试试效果一样
                                                await AXios.post(`../User/Update`, list).then(response => {
                                                    var data = response.data;
                                                //XEAjax.post(`../User/Update`, list).then(data => {                                                        
                                                    if (data.code == 200)
                                                        this.$refs.xGrid.commitProxy('query') //刷新表格
                                                    else
                                                        Vue.$XModal.message({ message: `修改失败：${data.msg}！`, status: 'error' })
                                                }).catch(() => {
                                                    Vue.$XModal.message({ message: '修改失败！', status: 'error' })
                                                })
                                        }
                                        //有可能同时做插入和修改
                                        if (body.insertRecords.length > 0) {
                                            var list = body.insertRecords;
                                            if (list != null && list != 'undefined' && list.length > 0)
                                            {
                                                for(var i= 0; i<list.length; i++)
