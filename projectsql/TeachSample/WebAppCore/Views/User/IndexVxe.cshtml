                                //{ field: 'NickName', title: columnName['NickName'], span: 4, itemRender: { name: '$input', props: { placeholder: '请输入'+columnName['NickName'] } } },
                                { field: 'phone', title: columnName['phone'], span: 4, itemRender: { name: '$input', props: { placeholder: '请输入' + columnName['phone'] } } },
                                { field: 'email', title: columnName['email'], span: 4, itemRender: { name: '$input', props: { placeholder: '请输入' + columnName['email'] } } },
                                { field: 'roleIds', title: columnName['roleIds'], span: 4, folding: true, itemRender: { name: '$input', props: { placeholder: '请输入' + columnName['roleIds'] } } },

