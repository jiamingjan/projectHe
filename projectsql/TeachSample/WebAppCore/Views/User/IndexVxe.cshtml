                checkColumnMethod({ column }) {
                    //if (['nickname', 'role'].includes(column.property)) {
                    //    return false
                    //}
                    return true
                },
                cellDBLClickEvent({ row }) {
                    //下面是vxe-grid的方式：直接前台提供数据显示
                    this.detailData = ['username', 'phone', 'email'].map(field => {
                        return {
                            label: this.$refs.xGrid.getColumnByField(field).title, value: row[field]
                        }
                    })
                    this.showDetails = true
                },
                editEvent(row) {
                  //Object.assign(this.editFormData, row)
                  this.editFormData = row;//注意这里是引用，数据是一份，弹出框（editFormData）改了，一行（row）也改了
                  this.selectRow = row
                  // this.selectRow = ['username', 'phone', 'email'].map(field => {
                  //       return {
                  //           label: this.$refs.xGrid.getColumnByField(field).title, value: row[field]
                  //       }
                  //   })
                  this.showEdit = true        
