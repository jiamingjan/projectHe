                                                    Vue.$XModal.message({ message: `删除失败：${data.msg}！`, status: 'error' })
                                                }).catch(() => {
                                                    Vue.$XModal.message({ message: '删除失败！', status: 'error' })
                                                })
                                            }
                                        }

