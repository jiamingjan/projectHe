            phone: "电话",
            sex:"性别",
            email: "邮箱",
            status:"状态",
            remark:"备注",
            avatar:"头像",
            postId:"岗位",
            deptId:"部门",
            create_time:"创建时间",
            update_time:"更新时间",
            roleIds: "角色"
        };

        let app = Vue.createApp({
            data() {
