                            storage: true, //是否启用 localStorage 本地保存，会将列操作状态保留在本地（需要有 id）
                            //自定义列是否允许列选中的方法，该方法的返回值用来决定这一列的 checkbox 是否可以选中
                            checkMethod: this.checkColumnMethod
                        },
                        printConfig: {
                            columns: [
                                { field: columnName.userId },
                                { field: columnName.username },
                                { field: columnName.nickName },
                                { field: columnName.phone },
                                { field: columnName.email },
                                { field: columnName.roleIds },                               
                            ]
                        },
                        sortConfig: {
                            trigger: 'cell' //（点击表头触发）
                        },
