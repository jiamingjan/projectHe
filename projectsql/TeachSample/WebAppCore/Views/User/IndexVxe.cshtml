@*特别注意：这里@@用到了2个@，正常html是一个@，因为cshtml @是绑定变量的意思，所以这里用2个@@
单击是@@cell-click*@
<div id="app">
   
    @*表格*@
    <vxe-grid ref='xGrid'
                v-bind="gridOptions"
                :row-style="rowStyle" @*行样式（颜色）函数*@
                @* :footer-method="footerMethod" *@ @*表尾统计*@
                @@cell-dblclick="cellDBLClickEvent">
    @*下面最好是写在js中*@
    <template v-slot:operate="{ row }">
        <vxe-button mode="text" icon="vxe-icon-edit" @@click="editEvent(row)"></vxe-button>
        <vxe-button mode="text" icon="vxe-icon-delete" @@click="removeEvent(row)"></vxe-button>
        @* <vxe-button @@click="showStatusEvent(row)">实时</vxe-button>
        <vxe-button icon="fa fa-line-chart" title="查看曲线" circle @@click="showChartEvent(row)"></vxe-button> *@
    </template>
        <template v-slot:history="{ row }">
            @* <vxe-button icon="fa fa-history" title="查看历史数据" circle @@click="showHistoryEvent(row)"></vxe-button> *@
            @*<vxe-button @@click="showHistoryEvent(row)">历史</vxe-button>*@
        </template>

    </vxe-grid>
    @*详情*@
    <vxe-modal v-model="showDetails" title="查看详情" width="600" height="400" :mask="false" :lock-view="false" resize>
        <template v-slot>
            <vxe-table border="inner"
                        auto-resize
                        show-overflow @*列文字过长用省略号*@                        
                        height="auto"
                        :show-header="false"
                        :sync-resize="showDetails"
                        :data="detailData">
                <vxe-table-column field="label" width="40%"></vxe-table-column>
                <vxe-table-column field="value"></vxe-table-column>
            </vxe-table>
        </template>
    </vxe-modal>
    <vxe-modal v-model="showEdit" :title="selectRow ? '编辑&保存' : '新增&保存'" width="800" min-width="600" min-height="300" :loading="submitLoading" resize destroy-on-close>
        <template #default>
            <vxe-form :data="editFormData" :rules="editRules" title-align="right" title-width="100" @@submit="editSubmit">                
                @* <vxe-form-item v-for="(value, key) in editFormData" :key="key" :field="key" ,title="key" :span="12" :item-render="{}">
                    <vxe-input v-model="value" placeholder="请输入"></vxe-input>
                </vxe-form-item> *@
                <vxe-form-item field="username" title="用户名" :span="12" :item-render="{}">
                    <template v-slot="{ data }">
                        <vxe-input v-model="data.username" placeholder="请输入名称"></vxe-input>
                    </template>
                </vxe-form-item>
                <vxe-form-item field="phone" title="phone" :span="12" :item-render="{}">
                    <template v-slot="{ data }">
                        <vxe-input v-model="data.phone" placeholder="请输入电话"></vxe-input>
                    </template>
                </vxe-form-item>
                <vxe-form-item align="center" title-align="left" :span="24">
                    <template #default>
                        <vxe-button type="submit">提交</vxe-button>
                        <vxe-button type="reset">重置</vxe-button>
                    </template>
                </vxe-form-item>
            </vxe-form>
        </template>
    </vxe-modal>
</div>


