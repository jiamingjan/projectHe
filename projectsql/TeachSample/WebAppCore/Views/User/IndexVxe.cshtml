                                    //   // 用于请求的权限拦截、设置请求头、Token 验证、参数等处理...  设置 Token 验证，预防 XSRF/CSRF 攻击
                                    //   request.headers.set('Authorization', `Bearer ${Cookies.get('token')}`)
                                    //   // 调用 next(),继续执行下一个拦截器
                                    //   next()
                                    // })
                                    return XEAjax.get(`../User/GetVxeTableData?rows=${page.pageSize}&page=${page.currentPage}`, queryParams)
                                },
                                delete: ({ body }) => {
                                    if (body != 'undefined') {
                                        var list = body.removeRecords;
