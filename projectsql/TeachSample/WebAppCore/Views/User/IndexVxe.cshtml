                                // 接收 Promise 对象
                                query: ({ page, sorts, filters, form }) => {
                                    this.$refs.xGrid.maximize()//最大化表格，放哪里最合适？有些地方xGrid为null
                                    //显示加载中,结束应该放哪里？
                                    //this.loading = true
